import java.io.*;

public class MiniMonitor {

    static final boolean WIN = System.getProperty("os.name").toLowerCase().contains("win");

    public static void main(String[] args) throws IOException, InterruptedException {

        String[] comando = WIN ? new String[]{"cmd", "/c", "dir"}
                               : new String[]{"ls", "-l"};

        ProcessBuilder pb = new ProcessBuilder(comando);

        Process p = pb.start();

        System.out.println("PID del proceso hijo: " + p.pid());

        BufferedReader br = new BufferedReader(new InputStreamReader(p.getInputStream()));

        String linea;
        int contador = 0;

        while ((linea = br.readLine()) != null) {
            contador++;
            System.out.println(contador + ": " + linea);
        }

        br.close();

        int codigoSalida = p.waitFor();

        System.out.println("\n=== INFORME FINAL ===");
        System.out.println("Número de líneas leídas: " + contador);
        System.out.println("Código de salida: " + codigoSalida);

        if (codigoSalida == 0) {
            System.out.println("El proceso terminó correctamente.");
        } else {
            System.out.println("El proceso falló.");
        }
    }
}